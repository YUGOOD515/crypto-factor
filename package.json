  "description": "Crypto Factor — an open library of weekly cryptocurrency factors (Cloudflare Workers static site).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "data": "node scripts/build-data.mjs",

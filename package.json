    "scrollama": "^3.2.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/matter-js": "^0.20.2",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",

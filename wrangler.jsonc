// Cloudflare Workers: static-assets-only deployment.
// Build with `npm run build` (writes ./dist), then `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crypto-factor",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false
  }
}
